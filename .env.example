# Public site URL (canonical URLs, sitemap, OG, structured data). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.brightdecor.com.au

# Google Search Console HTML-tag verification token (optional)
GOOGLE_SITE_VERIFICATION=

# --- Quote form delivery ---
# Where requests are sent, and the sender address (must be verified with your provider)
QUOTE_TO_EMAIL=max@brightdecor.com.au
QUOTE_FROM_EMAIL=quotes@brightdecor.com.au

# Set ONE email provider (the form uses every provider that is configured):

# A) Brevo (free plan): https://app.brevo.com/settings/keys/api
BREVO_API_KEY=

# B) Resend (free plan): https://resend.com/api-keys
RESEND_API_KEY=

# C) Any SMTP mailbox (Google Workspace, Microsoft 365, Zoho, GoDaddy, cPanel...)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional: instant Telegram message (bot from @BotFather, chat id via getUpdates)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
