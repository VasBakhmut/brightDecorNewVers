# Public site URL (canonical, sitemap, OG)
NEXT_PUBLIC_SITE_URL=https://www.brightdecor.com.au

# --- Quote form delivery (set at least one channel) ---
# Brevo transactional email (free plan is enough): https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
QUOTE_TO_EMAIL=max@brightdecor.com.au
# Must be a sender/domain verified in Brevo
QUOTE_FROM_EMAIL=quotes@brightdecor.com.au

# Optional: instant Telegram ping (create bot via @BotFather, get chat id via getUpdates)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
